<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>

<AnchorPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.five_nights_at_dana.Controllers.MainMenuController"
    prefWidth="1280" prefHeight="720"
    style="-fx-background-color: #000000;">

    <!-- Background image — swap out for final art -->
    <ImageView
        fx:id="backgroundImage"
        fitWidth="1280" fitHeight="720"
        preserveRatio="false"
        pickOnBounds="true"
        layoutX="0" layoutY="0"/>


<!--    &lt;!&ndash; Game Title &ndash;&gt;-->
<!--    <Label-->
<!--        fx:id="titleLabel"-->
<!--        text="Five Nights at Dana"-->
<!--        layoutX="340" layoutY="130"-->
<!--        prefWidth="600"-->
<!--        style="-fx-font-family: 'Courier New';-->
<!--               -fx-font-size: 52px;-->
<!--               -fx-font-weight: bold;-->
<!--               -fx-text-fill: #cc2200;-->
<!--               -fx-alignment: center;-->
<!--               -fx-effect: dropshadow(gaussian, #ff4400, 20, 0.6, 0, 0);"/>-->

    <!-- Start Button -->
    <Button
        fx:id="startButton"
        text="START GAME"
        onAction="#onStartGame"
        layoutX="215" layoutY="350"
        prefWidth="250" prefHeight="60"
        style="-fx-font-family: 'Courier New';
               -fx-font-size: 22px;
               -fx-font-weight: bold;
               -fx-text-fill: #ffffff;
               -fx-background-color: #1a1a1a;
               -fx-border-color: #cc2200;
               -fx-border-width: 2px;
               -fx-cursor: hand;"/>

    <!-- Volume Sliders -->
    <Label text = "Master Volume"
           layoutX = "35" layoutY = "540"
           prefWidth="180"
           alignment="CENTER" textAlignment="CENTER"
           style="-fx-font-family: 'Courier New';
               -fx-font-size: 19px;
               -fx-text-fill: #ffffff;
               -fx-background-color: #1a1a1a;
               -fx-border-color: #cc2200;
               -fx-border-width: 1px;"/>
    <Slider fx:id = "masterVolSlider"
            layoutX = "30" layoutY = "570" prefWidth = "190"
            min = "0.0" max = "1.0" value = "1.0"/>

    <Label text = "SFX Volume"
           layoutX = "35" layoutY = "600"
           prefWidth="180"
           alignment="CENTER" textAlignment="CENTER"
           style="-fx-font-family: 'Courier New';
               -fx-font-size: 19px;
               -fx-text-fill: #ffffff;
               -fx-background-color: #1a1a1a;
               -fx-border-color: #cc2200;
               -fx-border-width: 1px;"/>
    <Slider fx:id = "sfxVolSlider"
            layoutX = "30" layoutY = "630" prefWidth = "190"
            min = "0.0" max = "1.0" value = "1.0"/>

    <Label text = "Music Volume"
           layoutX = "35" layoutY = "660"
           prefWidth="180"
           alignment="CENTER" textAlignment="CENTER"
           style="-fx-font-family: 'Courier New';
               -fx-font-size: 19px;
               -fx-text-fill: #ffffff;
               -fx-background-color: #1a1a1a;
               -fx-border-color: #cc2200;
               -fx-border-width: 1px;"/>
    <Slider fx:id = "musicVolSlider"
            layoutX = "30" layoutY = "690" prefWidth = "190"
            min = "0.0" max = "1.0" value = "1.0"/>

</AnchorPane>
