<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<AnchorPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.five_nights_at_dana.Controllers.MainMenuController"
    prefWidth="1280" prefHeight="720"
    style="-fx-background-color: #000000;">

    <!-- Background image — swap out for final art -->
    <ImageView
        fx:id="backgroundImage"
        fitWidth="1280" fitHeight="720"
        preserveRatio="false"
        pickOnBounds="true"
        layoutX="0" layoutY="0"/>


    <!-- Game Title -->
    <Label
        fx:id="titleLabel"
        text="Five Nights at Dana"
        layoutX="340" layoutY="130"
        prefWidth="600"
        style="-fx-font-family: 'Courier New';
               -fx-font-size: 52px;
               -fx-font-weight: bold;
               -fx-text-fill: #cc2200;
               -fx-alignment: center;
               -fx-effect: dropshadow(gaussian, #ff4400, 20, 0.6, 0, 0);"/>

    <!-- Start Button -->
    <Button
        fx:id="startButton"
        text="START GAME"
        onAction="#onStartGame"
        layoutX="515" layoutY="400"
        prefWidth="250" prefHeight="60"
        style="-fx-font-family: 'Courier New';
               -fx-font-size: 22px;
               -fx-font-weight: bold;
               -fx-text-fill: #ffffff;
               -fx-background-color: #1a1a1a;
               -fx-border-color: #cc2200;
               -fx-border-width: 2px;
               -fx-cursor: hand;"/>

</AnchorPane>
