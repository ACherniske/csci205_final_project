<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="720" prefWidth="1280" style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.five_nights_at_dana.Controllers.CameraViewController">

    <Rectangle fill="#050505" height="648" layoutX="0" layoutY="0" stroke="#2a2a2a" strokeWidth="2" width="946" />
    <ImageView fx:id="cameraFeedImage" fitHeight="604" fitWidth="942" layoutX="2.0" layoutY="2.0" preserveRatio="false" />
    <Label fx:id="activeCameraLabel" layoutX="0" layoutY="610" prefWidth="946"
           style="-fx-font-family: 'Courier New'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #00ff41; -fx-alignment: center; -fx-background-color: #0a0a0a; -fx-padding: 6px 0;"
           text="CAM 1A — Entrance Hall" />
    <Button fx:id="lowerCamerasButton" layoutX="333" layoutY="668" onAction="#onLowerCameras" prefHeight="42" prefWidth="280"
            style="-fx-font-family: 'Courier New'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffcc00; -fx-background-color: #1a1a1a; -fx-border-color: #ffcc00; -fx-border-width: 2px; -fx-cursor: hand;"
            text="▼  LOWER CAMERAS" />

    <Label layoutX="952" layoutY="14" prefWidth="326" style="-fx-font-family: 'Courier New'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #00ff41; -fx-alignment: center;" text="SECURITY CAMERAS" />

    <Button fx:id="floor1Button" layoutX="952" layoutY="350" onAction="#onSelectFloor1" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #ffcc00; -fx-background-color: #2d2d2d; -fx-border-color: #ffcc00; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 1" />
    <Button fx:id="floor2Button" layoutX="1062" layoutY="350" onAction="#onSelectFloor2" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #aaaaaa; -fx-background-color: #1a1a1a; -fx-border-color: #555555; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 2" />
    <Button fx:id="floor3Button" layoutX="1172" layoutY="350" onAction="#onSelectFloor3" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #aaaaaa; -fx-background-color: #1a1a1a; -fx-border-color: #555555; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 3" />

    <Rectangle fill="#050505" height="244" layoutX="952" layoutY="388" stroke="#2a2a2a" strokeWidth="2" width="326" />
    <ImageView fx:id="floorMapImage" fitHeight="240" fitWidth="322" layoutX="954.0" layoutY="390.0" preserveRatio="false" />

    <Pane fx:id="floor1Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322">
        <Button fx:id="cam1A" text="1A" layoutX="10" layoutY="10" /> <Button fx:id="cam1B" text="1B" layoutX="40" layoutY="10" />
        <Button fx:id="cam1C" text="1C" layoutX="70" layoutY="10" /> <Button fx:id="cam1D" text="1D" layoutX="100" layoutY="10" />
        <Button fx:id="cam1E" text="1E" layoutX="130" layoutY="10" /> <Button fx:id="cam1F" text="1F" layoutX="160" layoutY="10" />
        <Button fx:id="camSL1" text="SL1" layoutX="10" layoutY="50" /> <Button fx:id="camSM1" text="SM1" layoutX="50" layoutY="50" />
        <Button fx:id="camSR1" text="SR1" layoutX="90" layoutY="50" />
    </Pane>

    <Pane fx:id="floor2Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322" visible="false">
        <Button fx:id="cam2A" text="2A" layoutX="10" layoutY="10" /> <Button fx:id="cam2B" text="2B" layoutX="40" layoutY="10" />
        <Button fx:id="cam2C" text="2C" layoutX="70" layoutY="10" /> <Button fx:id="camBucky" text="Bucky" layoutX="100" layoutY="10" />
        <Button fx:id="camSL2" text="SL2" layoutX="10" layoutY="50" /> <Button fx:id="camSM2" text="SM2" layoutX="50" layoutY="50" />
        <Button fx:id="camSR2" text="SR2" layoutX="90" layoutY="50" />
    </Pane>

    <Pane fx:id="floor3Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322" visible="false">
        <Button fx:id="cam3A" text="3A" layoutX="10" layoutY="10" /> <Button fx:id="cam3B" text="3B" layoutX="40" layoutY="10" />
        <Button fx:id="cam3C" text="3C" layoutX="70" layoutY="10" /> <Button fx:id="cam3D" text="3D" layoutX="100" layoutY="10" />
        <Button fx:id="camSL3" text="SL3" layoutX="10" layoutY="50" /> <Button fx:id="camSM3" text="SM3" layoutX="50" layoutY="50" />
        <Button fx:id="camSR3" text="SR3" layoutX="90" layoutY="50" />
    </Pane>

</AnchorPane>