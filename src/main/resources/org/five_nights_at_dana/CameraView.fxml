<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="720" prefWidth="1280" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.five_nights_at_dana.Controllers.CameraViewController">

    <!-- ── CAMERA FEED (left panel) ──────────────────────────────────── -->
    <Rectangle fill="#050505" height="648" layoutX="0" layoutY="0" stroke="#2a2a2a" strokeWidth="2" width="946" />
    <ImageView fx:id="cameraFeedImage" fitHeight="604" fitWidth="942" layoutX="2.0" layoutY="2.0" preserveRatio="false" />
    <Label fx:id="activeCameraLabel" layoutX="0" layoutY="610" prefWidth="946" style="-fx-font-family: 'Courier New'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #00ff41; -fx-alignment: center; -fx-background-color: #0a0a0a; -fx-padding: 6px 0;" text="CAM 1A — Entrance Hall" />
    <Button fx:id="lowerCamerasButton" layoutX="333" layoutY="668" onAction="#onLowerCameras" prefHeight="42" prefWidth="280" style="-fx-font-family: 'Courier New'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffcc00; -fx-background-color: #1a1a1a; -fx-border-color: #ffcc00; -fx-border-width: 2px; -fx-cursor: hand;" text="▼  LOWER CAMERAS" />

    <!-- ── RIGHT PANEL HEADER ─────────────────────────────────────────── -->
    <Label layoutX="952" layoutY="14" prefWidth="326" style="-fx-font-family: 'Courier New'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #00ff41; -fx-alignment: center;" text="SECURITY CAMERAS" />

    <!-- ── FLOOR TABS ─────────────────────────────────────────────────── -->
    <Button fx:id="floor1Button" layoutX="952" layoutY="350" onAction="#onSelectFloor1" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #ffcc00; -fx-background-color: #2d2d2d; -fx-border-color: #ffcc00; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 1" />
    <Button fx:id="floor2Button" layoutX="1062" layoutY="350" onAction="#onSelectFloor2" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #aaaaaa; -fx-background-color: #1a1a1a; -fx-border-color: #555555; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 2" />
    <Button fx:id="floor3Button" layoutX="1172" layoutY="350" onAction="#onSelectFloor3" prefHeight="34" prefWidth="108" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px; -fx-text-fill: #aaaaaa; -fx-background-color: #1a1a1a; -fx-border-color: #555555; -fx-border-width: 2px; -fx-cursor: hand;" text="FLOOR 3" />

    <!-- ── MAP BACKGROUND (must come before the floor panes) ─────────── -->
    <Rectangle fill="#050505" height="244" layoutX="952" layoutY="388" stroke="#2a2a2a" strokeWidth="2" width="326" />
    <ImageView fx:id="floorMapImage" fitHeight="240" fitWidth="322" layoutX="954.0" layoutY="390.0" preserveRatio="false" />

    <!-- ── FLOOR PANES (all after the map so buttons render on top) ───── -->
    <Pane fx:id="floor1Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322">
        <Button fx:id="cam1A" layoutX="-1.0" layoutY="144.0" text="1A" /> <Button fx:id="cam1B" layoutX="49.0" layoutY="108.0" text="1B" />
        <Button fx:id="cam1C" layoutX="9.0" layoutY="83.0" text="1C" /> <Button fx:id="cam1D" layoutX="115.0" layoutY="71.0" text="1D" />
        <Button fx:id="cam1E" layoutX="35.0" layoutY="144.0" text="1E" /> <Button fx:id="cam1F" layoutX="64.0" layoutY="194.0" text="1F" />
        <Button fx:id="camSL1" layoutX="115.0" layoutY="108.0" text="SL1" /> <Button fx:id="camSM1" layoutX="24.0" layoutY="169.0" text="SM1" />
        <Button fx:id="camSR1" layoutX="112.0" layoutY="181.0" text="SR1" />
    </Pane>

    <Pane fx:id="floor2Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322">
        <Button fx:id="cam2A" layoutX="32.0" layoutY="96.0" text="2A" /> <Button fx:id="cam2B" layoutX="10.0" layoutY="133.0" text="2B" />
        <Button fx:id="cam2C" layoutX="75.0" layoutY="96.0" text="2C" /> <Button fx:id="camBucky" layoutX="1.0" layoutY="214.0" text="Bucky" />
        <Button fx:id="camSL2" layoutX="115.0" layoutY="108.0" text="SL2" /> <Button fx:id="camSM2" layoutX="35.0" layoutY="168.0" text="SM2" />
        <Button fx:id="camSR2" layoutX="114.0" layoutY="180.0" text="SR2" />
        <ImageView fitHeight="240.0" fitWidth="322.0" layoutX="1.0" layoutY="1.0">
            <image>
                <Image url="@../../assets/images/Map_Floor3.png" />
            </image>
        </ImageView>
    </Pane>

    <Pane fx:id="floor3Pane" layoutX="954" layoutY="390" prefHeight="240" prefWidth="322">
        <Button fx:id="cam3A" layoutX="4.0" layoutY="83.0" text="3A" /> <Button fx:id="cam3B" layoutX="60.0" layoutY="108.0" text="3B" />
        <Button fx:id="cam3C" layoutX="-1.0" layoutY="158.0" text="3C" /> <Button fx:id="cam3D" layoutX="4.0" layoutY="214.0" text="3D" />
        <Button fx:id="camSL3" layoutX="116.0" layoutY="108.0" text="SL3" /> <Button fx:id="camSM3" layoutX="35.0" layoutY="183.0" text="SM3" />
        <Button fx:id="camSR3" layoutX="115.0" layoutY="189.0" text="SR3" />
    </Pane>

</AnchorPane>
